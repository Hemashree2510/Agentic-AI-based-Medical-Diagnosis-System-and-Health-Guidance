# ==============================================================================
# ENVIRONMENT CONFIGURATION EXAMPLE
# Copy this file to '.env' and populate with your local configuration.
# Never commit '.env' containing real secrets to version control!
# ==============================================================================

# Google Gemini API Configuration (via google-genai)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# SQLite Database Connection String
DATABASE_URL=sqlite:///medical_ai.db

# OpenStreetMap / Overpass API Endpoint for Hospital Search
HOSPITAL_API_URL=https://overpass-api.de/api/interpreter

# Prototype Demo Mode Toggle (true / false)
# When true: Displays demo doctor and slot availability
# When false: Strictly submits appointment requests without fabricating availability
DEMO_MODE=true

# Regional Configuration
DEFAULT_REGION=India
